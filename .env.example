# ───────── Supabase (프로젝트 설정 → API) ─────────
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 서버 전용. 절대 브라우저 코드에 넣지 마세요.
SUPABASE_SERVICE_ROLE_KEY=

# ───────── OpenAI ─────────
OPENAI_API_KEY=
# 음성 대화 모델 (PoC에서 gpt-realtime-2.1 / gpt-realtime-2.1-mini 비교 후 확정)
OPENAI_REALTIME_MODEL=gpt-realtime-2.1-mini
# 음성 전사(자막) 모델
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
# 텍스트 대화(AI 고객) 모델
OPENAI_CHAT_MODEL=gpt-5-mini
# 고객 감정 판단 모델 (빠르고 저렴한 모델 권장)
OPENAI_CLASSIFIER_MODEL=gpt-5-mini
# 평가·리포트 모델
OPENAI_EVAL_MODEL=gpt-5-mini
# 추론형 모델(gpt-5 계열)의 사고량. 대화·감정 판단 속도를 위해 low 권장. 추론형이 아닌 모델이면 비워 두세요.
OPENAI_REASONING_EFFORT=low

# ───────── OpenAI 실제 청구액 조회 (선택, Vercel에만) ─────────
# 관리자 화면 '사용량·비용'에 OpenAI 실제 청구액을 보여 줄 때 필요. 조직 소유자가 Admin keys 에서 발급.
# 일반 API 키보다 권한이 훨씬 강하니 Sensitive 로 저장하세요.
OPENAI_ADMIN_KEY=
# (선택) 조직에 다른 서비스도 있다면 이 서비스 프로젝트 ID(proj_...)만 집계
OPENAI_PROJECT_ID=

# ───────── 웹앱 ↔ 상시 서버(worker) ─────────
# worker 배포 주소 (예: https://inhub-worker.up.railway.app)
WORKER_URL=http://localhost:8787
# 두 서버가 서로를 확인하는 비밀값 (아무 긴 무작위 문자열)
WORKER_SHARED_SECRET=change-me-to-a-long-random-string

# ───────── worker 전용 ─────────
PORT=8787
# 동시에 처리할 리포트 생성 작업 수
EVAL_CONCURRENCY=4
